		<main class="stage" id="stage">
			<canvas id="globe" aria-hidden="true"></canvas>
			<a class="brand-corner" id="brand-corner" href={base} aria-label="iroha home" aria-hidden="true" tabindex="-1">
				<img src={logoUrl} alt="" width="132" height="33" />
			</a>
			<header class="hero" id="hero">
				<p class="kicker"><span class="k-desk">Autorouting global networks with</span><span class="k-mob">Autorouting<br />global networks with</span></p>
				<a class="brand" id="brand" href={base} aria-label="iroha home">
					<img src={logoUrl} alt="iroha" width="320" height="80" />
				</a>
				<p class="sub"><b>iroh</b>-style P2P mesh networking <br />in Tailscale</p>
				<div class="scroll-cue" aria-hidden="true">
					<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M6 9.5 10.5 14 15 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						<path d="M6 14.5 10.5 19 15 14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />
					</svg>
				</div>
			</header>
		</main>

		<section class="hold" id="planner">
			<div class="hold-sticky">
				<div class="hold-inner">
					<div class="planner" id="planner-card">
						<div class="pl-col-build" id="sidekick">
							<div class="outage-banner" id="outage-banner">
								<span class="pulse"></span>
								<span>Simulating outage — rerouting around failed nodes</span>
							</div>

							<h2>Simulate your mesh</h2>
							<p class="pl-sub">Enter a server location below to see it on the globe</p>

							<div class="adder">
								<select id="csp-select" aria-label="Cloud service provider"></select>
								<div class="loc-field">
									<input type="text" id="loc-input" placeholder="Location…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="loc-suggest" aria-autocomplete="list" />
									<div class="suggest-list" id="loc-suggest" role="listbox" hidden></div>
								</div>
								<button class="btn-add" id="btn-add" aria-label="Add location" disabled>+</button>
							</div>
							<div class="adder-hint" id="adder-hint">Pick a provider, then a location.</div>
							<div class="drafts" id="drafts"></div>

							<h3 class="active-head loc-list-narrow-head">Active locations</h3>
							<div class="loc-list" id="loc-list"></div>

							<div class="pl-actions">
								<button class="btn-clear" id="btn-clear">Clear All</button>
								<button class="btn-sim" id="btn-simulate">Simulate Outage</button>
							</div>
						</div>

						<div class="pl-divider" aria-hidden="true"></div>

						<div class="pl-col-active" id="sidekick-wide" aria-label="Active deployment locations">
							<h2>Active locations</h2>
							<div class="active-count" id="active-count"></div>
							<div class="loc-list-side" id="loc-list-side"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="next" aria-hidden="true"></div>

		<footer class="footer">
			<span class="f-brand">iroha</span>
			<span class="f-sep">|</span>
			<span>iroh-style p2p mesh in tailscale</span>
			<span class="f-sep">|</span>
