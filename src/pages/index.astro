				{ id: "vps-cordoba", name: "VPS Córdoba", city: "Córdoba", provider: "vps", lat: -31.4201, lon: -64.1888 },
				{ id: "vps-rosario", name: "VPS Rosario", city: "Rosario", provider: "vps", lat: -32.9442, lon: -60.6505 },
				{ id: "vps-mendoza", name: "VPS Mendoza", city: "Mendoza", provider: "vps", lat: -32.8908, lon: -68.8272 },
				{ id: "vps-valparaiso", name: "VPS Valparaíso", city: "Valparaíso", provider: "vps", lat: -33.0472, lon: -71.6219 },
				{ id: "vps-concepcion", name: "VPS Concepción", city: "Concepción", provider: "vps", lat: -36.8282, lon: -73.0514 },
				{ id: "vps-antofagasta", name: "VPS Antofagasta", city: "Antofagasta", provider: "vps", lat: -23.65, lon: -70.4 },
				{ id: "vps-arequipa", name: "VPS Arequipa", city: "Arequipa", provider: "vps", lat: -16.409, lon: -71.5375 },
				{ id: "vps-trujillo", name: "VPS Trujillo", city: "Trujillo", provider: "vps", lat: -8.1091, lon: -79.0215 },
				{ id: "vps-cusco", name: "VPS Cusco", city: "Cusco", provider: "vps", lat: -13.5319, lon: -71.9675 },
				{ id: "vps-punta-arenas", name: "VPS Punta Arenas", city: "Punta Arenas", provider: "vps", lat: -53.1638, lon: -70.9171 },
				{ id: "vps-ushuaia", name: "VPS Ushuaia", city: "Ushuaia", provider: "vps", lat: -54.8019, lon: -68.303 },
				{ id: "vps-stanley", name: "VPS Stanley", city: "Stanley", provider: "vps", lat: -51.6977, lon: -57.8517 },
				{ id: "vps-king-edward", name: "VPS King Edward Point", city: "King Edward Point", provider: "vps", lat: -54.2833, lon: -36.4942 },
			];

			const ALL_LOCS = [...CLOUD_LOCS, ...VPS_LOCS];

			const activeLocs = new Set<string>();
			let simulating = false;

			function providerLabel(pid: string): string {
				return CLOUD_PROVIDERS.find((p) => p.id === pid)?.label ?? pid;
			}

			const PROVIDER_CODE: Record<string, string> = {
				aws: "AWS", azure: "AZURE", gcp: "GCP", cloudflare: "CF",
				alibaba: "ALI", oracle: "OCI", ibm: "IBM", huawei: "HW",
				tencent: "TX", vps: "VPS",
			};
			function providerCode(pid: string): string {
				return PROVIDER_CODE[pid] ?? pid.toUpperCase();
			}
			function locSlug(l: Loc): string {
				const m = l.id.match(/^(vps|aws|azure|gcp|cf|ali|oci|ibm|hw|tx)[-_](.+)$/i);
				const raw = m ? m[2] : l.city;
				return raw.toLowerCase().replace(/[\s_]+/g, "-").replace(/[^a-z0-9-]/g, "").replace(/-+/g, "-").replace(/^-|-$/g, "");
			}
			function nodeName(l: Loc): string {
				return `${providerCode(l.provider)} ${locSlug(l)}`;
			}

			function dotColor(pid: string): string {
				return pid === "vps" ? "#f1eaf4" :
					pid === "aws" ? "#ff9900" :
					pid === "azure" ? "#0078d4" :
					pid === "gcp" ? "#4285f4" :
					pid === "cloudflare" ? "#f38020" :
					pid === "alibaba" ? "#ff6a00" :
					pid === "oracle" ? "#c74634" :
					pid === "ibm" ? "#054ada" :
					pid === "huawei" ? "#cf0a2c" :
					"#e4002b";
			}

			const plannerCard = document.getElementById("planner-card") as HTMLDivElement;
			const cspSelect = document.getElementById("csp-select") as HTMLSelectElement;
			const locInput = document.getElementById("loc-input") as HTMLInputElement;
			const suggestBox = document.getElementById("loc-suggest") as HTMLDivElement;
			const adderHint = document.getElementById("adder-hint") as HTMLDivElement;
			const draftsBox = document.getElementById("drafts") as HTMLDivElement;
			const btnAdd = document.getElementById("btn-add") as HTMLButtonElement;
			const locListEl = document.getElementById("loc-list") as HTMLDivElement;
			const locListSide = document.getElementById("loc-list-side") as HTMLDivElement;
			const activeCount = document.getElementById("active-count") as HTMLDivElement;
			const btnClear = document.getElementById("btn-clear") as HTMLButtonElement;
			const btnSimulate = document.getElementById("btn-simulate") as HTMLButtonElement;
			const outageBanner = document.getElementById("outage-banner") as HTMLDivElement;
			draftsBox.style.display = "none";

			const CSP_EMPTY = "";
			function buildProviders() {
				cspSelect.innerHTML = "";
				const ph = document.createElement("option");
				ph.value = CSP_EMPTY;
				ph.textContent = "CSP…";
				ph.disabled = true;
				ph.selected = true;
				cspSelect.appendChild(ph);
				for (const p of [{ id: "vps", label: "VPS" }, ...CLOUD_PROVIDERS]) {
					const o = document.createElement("option");
					o.value = p.id;
					o.textContent = p.label;
					cspSelect.appendChild(o);
				}
				cspSelect.addEventListener("change", () => {
					if (cspSelect.value) locInput.focus({ preventScroll: true });
				});
			}

			function locsForCsp(pid: string): Loc[] {
				return ALL_LOCS
					.filter((l) => l.provider === pid && !activeLocs.has(l.id))
					.sort((a, b) => a.city.localeCompare(b.city));
			}

			function matchScore(l: Loc, q: string): number {
				const city = l.city.toLowerCase();
				const name = l.name.toLowerCase();
				if (city === q || name === q) return 0;
				if (city.startsWith(q)) return 1;
				if (name.startsWith(q)) return 2;
				const ci = city.indexOf(q);
				if (ci >= 0) return 3 + ci / 100;
				const ni = name.indexOf(q);
				if (ni >= 0) return 5 + ni / 100;
				return 99;
			}

			function suggestCap(): number {
				return window.innerWidth < 760 ? 3 : 8;
			}
			function suggestions(): Loc[] {
				const q = locInput.value.trim().toLowerCase();
				const pid = cspSelect.value;
				if (!pid) return [];
				const pool = locsForCsp(pid);
				const cap = suggestCap();
				if (!q) return pool.slice(0, cap);
				return pool
					.map((l) => ({ l, s: matchScore(l, q) }))
					.filter((r) => r.s < 99)
					.sort((a, b) => a.s - b.s || a.l.city.localeCompare(b.l.city))
					.slice(0, cap)
					.map((r) => r.l);
			}

			let hlIdx = -1;
			function addAllRow(pid: string): HTMLButtonElement {
				const b = document.createElement("button");
				b.type = "button";
				b.classList.add("s-addall");
				const left = locsForCsp(pid);
				b.innerHTML = `<span class="s-addall-label">Add all ${providerLabel(pid)}</span><span class="s-addall-count">${left.length} locations</span>`;
				b.addEventListener("mousedown", (e) => {
					e.preventDefault();
					for (const l of locsForCsp(pid)) addLoc(l.id, { keepFocus: false });
					hideSuggest();
					refreshLocOptions();
				});
				return b;
			}
			function renderSuggest() {
				const pid = cspSelect.value;
				suggestBox.innerHTML = "";
				hlIdx = -1;
				if (!pid) {
					suggestBox.hidden = true;
					locInput.setAttribute("aria-expanded", "false");
					return;
				}
				const items = suggestions();
				const bulkable = pid !== "vps" && locsForCsp(pid).length > 0;
				if (!items.length && !bulkable) {
					suggestBox.hidden = true;
					locInput.setAttribute("aria-expanded", "false");
					return;
				}
				suggestBox.hidden = false;
				locInput.setAttribute("aria-expanded", "true");
				if (bulkable) {
					suggestBox.appendChild(addAllRow(pid));
				}
				items.forEach((l) => {
					const b = document.createElement("button");
					b.type = "button";
					b.setAttribute("role", "option");
					b.title = `${nodeName(l)} — ${l.city}`;
					b.innerHTML = `<span class="s-dot" style="background:${dotColor(l.provider)}"></span><span class="s-city">${nodeName(l)}</span>`;
					b.addEventListener("mousedown", (e) => {
						e.preventDefault();
						addLoc(l.id);
						hideSuggest();
					});
					suggestBox.appendChild(b);
				});
				const rows = [...suggestBox.querySelectorAll("button")];
				hlIdx = rows.length ? 0 : -1;
				rows.forEach((b, i) => b.classList.toggle("hl", i === hlIdx));
			}
			function hideSuggest() {
				suggestBox.hidden = true;
				locInput.setAttribute("aria-expanded", "false");
			}

			function refreshLocOptions() {
				const pid = cspSelect.value;
				locInput.value = "";
				const n = locsForCsp(pid).length;
				locInput.placeholder = !pid ? "Pick a CSP first…" : `Location… (${n})`;
				locInput.disabled = false;
				adderHint.textContent = !pid
					? "Pick a provider, then a location."
					: n ? `Type to filter ${n} ${providerLabel(pid)} locations.` : `All ${providerLabel(pid)} locations added.`;
				hideSuggest();
				syncAdd();
			}

			function resolveLocId(): string | null {
				const typed = locInput.value.trim().toLowerCase();
				if (!typed) return null;
				const pid = cspSelect.value;
				const pool = pid ? locsForCsp(pid) : ALL_LOCS.filter((l) => !activeLocs.has(l.id));
				const ranked = pool
					.map((l) => ({ l, s: matchScore(l, typed) }))
					.filter((r) => r.s < 99)
					.sort((a, b) => a.s - b.s);
				return ranked.length ? ranked[0].l.id : null;
			}

			function syncAdd() {
				btnAdd.disabled = resolveLocId() === null;
			}

			cspSelect.addEventListener("change", refreshLocOptions);
			locInput.addEventListener("input", () => { renderSuggest(); syncAdd(); });
			locInput.addEventListener("focus", () => {
				if (!cspSelect.value) hideSuggest();
				else renderSuggest();
			});
			locInput.addEventListener("pointerdown", (e) => {
				if (!cspSelect.value) {
					e.preventDefault();
					hideSuggest();
					locInput.blur();
					cspSelect.focus({ preventScroll: true });
					cspSelect.classList.remove("nudge");
					void cspSelect.offsetWidth;
					cspSelect.classList.add("nudge");
				}
			});
			locInput.addEventListener("blur", () => setTimeout(hideSuggest, 120));
			locInput.addEventListener("keydown", (ev) => {
				const items = [...suggestBox.querySelectorAll("button")];
				if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
					if (!items.length) return;
					ev.preventDefault();
					hlIdx = ev.key === "ArrowDown"
						? (hlIdx + 1) % items.length
						: (hlIdx - 1 + items.length) % items.length;
					items.forEach((b, i) => b.classList.toggle("hl", i === hlIdx));
					items[hlIdx].scrollIntoView({ block: "nearest" });
				} else if (ev.key === "Enter") {
					const row = hlIdx >= 0 ? items[hlIdx] : null;
					if (row) {
						row.dispatchEvent(new MouseEvent("mousedown", { bubbles: true, cancelable: true }));
					} else {
						const id = resolveLocId();
						if (id) { addLoc(id); hideSuggest(); }
					}
				} else if (ev.key === "Escape") {
					hideSuggest();
				}
			});
			btnAdd.addEventListener("click", () => {
				const id = resolveLocId();
				if (id) { addLoc(id); hideSuggest(); }
			});

			function addLoc(id: string, opts: { keepFocus?: boolean } = {}) {
				if (activeLocs.has(id)) return;
				const loc = ALL_LOCS.find((l) => l.id === id);
				if (!loc) return;
				activeLocs.add(id);
				api.addNode(loc.id, nodeName(loc), loc.lat, loc.lon);
				locInput.value = "";
				renderList();
				refreshLocOptions();
				if (opts.keepFocus !== false) locInput.focus({ preventScroll: true });
			}

			function removeLoc(id: string) {
				const rows = [
					...locListEl.querySelectorAll(`[data-loc="${id}"]`),
					...locListSide.querySelectorAll(`[data-loc="${id}"]`),
				] as HTMLElement[];
				rows.forEach((r) => r.classList.add("leaving"));
				window.setTimeout(() => {
					stopLatTimer(id);
					activeLocs.delete(id);
					api.removeNode(id);
					renderList();
					refreshLocOptions();
				}, rows.length ? 180 : 0);
			}

			const latTimers = new Map<string, ReturnType<typeof setInterval>>();
			function stopLatTimer(id: string) {
				const t = latTimers.get(id);
				if (t !== undefined) { clearInterval(t); latTimers.delete(id); }
			}
			function locRow(l: Loc): HTMLDivElement {
				const div = document.createElement("div");
				div.className = "loc-item";
				div.dataset.loc = l.id;
				const nm = nodeName(l);
				div.innerHTML = `<span class="rule">|</span><span class="cps">${providerCode(l.provider)}</span><span class="name">${nm.slice(providerCode(l.provider).length + 1)}</span><span class="geo">(${l.city})</span><svg class="spark" width="44" height="14" viewBox="0 0 44 14" aria-hidden="true"><polyline points="" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/></svg><span class="lat">--ms</span><button class="remove" type="button" aria-label="Remove ${nm}" title="Remove ${nm}">x</button>`;
				(div.querySelector(".remove") as HTMLButtonElement).addEventListener("click", () => removeLoc(l.id));
				div.addEventListener("mouseenter", () => api.pingNode(l.id));
				div.addEventListener("mouseleave", () => api.pingNode(null));
				div.addEventListener("focusin", () => api.pingNode(l.id));
				div.addEventListener("focusout", () => api.pingNode(null));
				const latEl = div.querySelector(".lat") as HTMLElement;
				const line = div.querySelector(".spark polyline") as SVGPolylineElement;
				const paint = () => {
					const v = api.getLatency(l.id);
					latEl.textContent = v === null ? "--ms" : `${v.toFixed(0)}ms`;
					const hist = api.getHistory(l.id);
					if (!hist || hist.length < 2) return;
					const max = Math.max(...hist), min = Math.min(...hist);
					const span = Math.max(1e-6, max - min);
					const n = hist.length;
					const pts = hist.map((h, i) => {
						const x = (i / (n - 1)) * 42 + 1;
						const y = 12 - ((h - min) / span) * 10;
						return `${x.toFixed(1)},${y.toFixed(1)}`;
					}).join(" ");
					line.setAttribute("points", pts);
					line.style.color = v !== null && v < 40 ? "#2b856c" : v !== null && v < 90 ? "#d8a93b" : "#d4589d";
				};
				paint();
				stopLatTimer(l.id);
				latTimers.set(l.id, setInterval(() => {
					if (!div.isConnected) { stopLatTimer(l.id); return; }
					paint();
				}, 1000));
				return div;
			}

			const globeCanvas = document.getElementById("globe") as HTMLCanvasElement;
			globeCanvas.style.pointerEvents = "none";
			function syncGlobeClicks() {
				globeCanvas.style.pointerEvents = inHoldZone() ? "auto" : "none";
			}
			window.addEventListener("scroll", syncGlobeClicks, { passive: true });
			globeCanvas.addEventListener("click", (ev) => {
				const r = globeCanvas.getBoundingClientRect();
				const hit = api.nodeAt(ev.clientX - r.left, ev.clientY - r.top);
				if (!hit) return;
				const row = document.querySelector(`.loc-item[data-loc="${hit.key}"]`) as HTMLElement | null;
				if (row) {
					row.scrollIntoView({ block: "nearest", behavior: "smooth" });
					row.animate(
						[{ boxShadow: "0 0 0 0 rgba(212,88,157,0.0)" }, { boxShadow: "0 0 0 3px rgba(212,88,157,0.55)" }, { boxShadow: "0 0 0 0 rgba(212,88,157,0.0)" }],
						{ duration: 700, easing: "ease-out" },
					);
					(row.querySelector(".remove") as HTMLButtonElement | null)?.focus({ preventScroll: true });
				} else {
					const known = ALL_LOCS.find((l) => l.id === hit.key);
					if (known) {
						cspSelect.value = known.provider;
						refreshLocOptions();
						locInput.value = known.city;
						renderSuggest();
						syncAdd();
						setCard(true);
					}
					api.pingNode(hit.key);
					window.setTimeout(() => api.pingNode(null), 950);
				}
			});

			const EMPTY_HINT = `<div class="pl-empty">No locations yet.<br/>Pick a CSP + location above.</div>`;

			const footCount = document.getElementById("foot-count") as HTMLElement;
			function paintFoot(n: number) {
				footCount.textContent = n === 0 ? "mesh: empty" : n === 1 ? "mesh: 1 node" : `mesh: ${n} nodes`;
			}
			function renderList() {
				const locs = ALL_LOCS.filter((l) => activeLocs.has(l.id));
				activeCount.textContent = locs.length === 1 ? "1 active" : `${locs.length} active`;
				paintFoot(locs.length);
				for (const list of [locListEl, locListSide]) {
					list.innerHTML = "";
					if (locs.length === 0) {
						list.innerHTML = EMPTY_HINT;
					} else {
						for (const l of locs) list.appendChild(locRow(l));
					}
				}
				const empty = activeLocs.size === 0;
				btnClear.disabled = empty;
				btnSimulate.disabled = empty;
				if (empty && simulating) {
					simulating = false;
					btnSimulate.textContent = "Simulate Outage";
					btnSimulate.classList.remove("on");
					outageBanner.classList.remove("active");
					api.simulateOutage(false);
				}
			}

			btnClear.addEventListener("click", () => {
				for (const id of [...activeLocs]) { stopLatTimer(id); api.removeNode(id); }
				activeLocs.clear();
				renderList();
				refreshLocOptions();
			});

			btnSimulate.addEventListener("click", () => {
				simulating = !simulating;
				if (simulating) {
					btnSimulate.textContent = "Stop Simulation";
					btnSimulate.classList.add("on");
					outageBanner.classList.add("active");
					api.simulateOutage(true);
				} else {
					btnSimulate.textContent = "Simulate Outage";
					btnSimulate.classList.remove("on");
					outageBanner.classList.remove("active");
					api.simulateOutage(false);
				}
			});

			const hero = document.getElementById("hero") as HTMLElement;
			const stageEl = document.getElementById("stage") as HTMLElement;
			const planner = document.getElementById("planner") as HTMLElement;
			const brand = document.getElementById("brand") as HTMLAnchorElement;

			const brandCorner = document.getElementById("brand-corner") as HTMLAnchorElement;

			function heroScrub() {
				const track = Math.max(1, stageEl.offsetHeight);
				const p = Math.min(1, Math.max(0, window.scrollY / track));
				const eased = p * p * (3 - 2 * p);
				hero.style.opacity = String(1 - Math.min(1, eased * 2.4));
				const show = p > 0.45;
				brandCorner.classList.toggle("show", show);
				brandCorner.setAttribute("aria-hidden", show ? "false" : "true");
				brandCorner.tabIndex = show ? 0 : -1;
			}
			window.addEventListener("scroll", heroScrub, { passive: true });
			window.addEventListener("resize", heroScrub);
			heroScrub();

			let cardShown = false;
			let cardBoosted = false;
			let globeReady = false;

			function cardUsable(): boolean {
				return inHoldZone() && globeReady;
			}

			function setCard(on: boolean) {
				if (on === cardShown) return;
				cardShown = on;
				plannerCard.classList.toggle("visible", on);
				plannerCard.inert = !on;
				if (on) hideSuggest();
			}
			plannerCard.inert = true;

			window.addEventListener("iroha:globe-settled", () => {
				cardBoosted = true;
				globeReady = true;
				syncHold();
			});

			function inHoldZone() {
				const r = planner.getBoundingClientRect();
				return r.top <= window.innerHeight * 0.25 && r.bottom > window.innerHeight * 0.6;
			}

			function holdProgress() {
				const total = Math.max(1, planner.offsetHeight - window.innerHeight);
				const done = Math.min(Math.max(-planner.getBoundingClientRect().top, 0), total);
				return done / total;
			}

			function syncHold() {
				if (!inHoldZone()) globeReady = false;
				setCard(cardUsable());
				const p = holdProgress();
				if (!cardShown) return;
				const base = Math.max(0, 1 - p * 3) * 28;
				const lift = cardBoosted ? Math.min(base, 6) : base;
				plannerCard.style.translate = `0 ${lift.toFixed(1)}px`;
			}

			window.addEventListener("scroll", syncHold, { passive: true });
			window.addEventListener("resize", syncHold);
			syncGlobeClicks();
			if (api.getProgress() > 0.9) {
				globeReady = true;
				cardBoosted = true;
			}
			if ("requestAnimationFrame" in window) {
				requestAnimationFrame(() => { heroScrub(); syncHold(); });
				setTimeout(() => { heroScrub(); syncHold(); if (api.getProgress() > 0.9) { globeReady = true; syncHold(); } }, 400);
			} else {
				syncHold();
			}

			const DEMO_SEED = ["aws-us-east-1", "aws-eu-central-1", "aws-ap-northeast-1", "azure-southeastasia"];

			buildProviders();
			refreshLocOptions();
			renderList();
			for (const id of DEMO_SEED) addLoc(id);
		</script>
	</body>
</html>
