---
import "../styles/fonts.css";
import mplusUrl from "../assets/fonts/MPlusRounded1c-Bold.woff2?url";
import sgUrl from "../assets/fonts/sg-500.woff2?url";
import novaUrl from "../assets/fonts/NovaMono-Regular.ttf?url";
import logoUrl from "../../public/logo.svg?url";
import logoSQUrl from "../../public/logosq.svg?url";
const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const asset = (p: string) => `${base}${p}`.replace(/([^:])\/+/g, "$1/");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={logoSQUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="iroha | iroh-based P2P mesh networking in Tailscale"
		/>
		<title>iroha | iroh-based P2P mesh networking in Tailscale</title>
		<link
			rel="preload"
			href={mplusUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={sgUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={novaUrl}
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<style is:global>
			@layer reset, tokens, base, components;

			@layer reset {
				*, *::before, *::after { box-sizing: border-box; }
				* { margin: 0; }
			}

			@layer tokens {
				:root {
					--color-bg: #160e2c;
					--color-text: #f1eaf4;
					--color-muted: #b9aec9;
					--color-primary: #d4589d;
					--color-iroh: #6257F7;
					--color-gradient-a: #feeae4;
					--color-gradient-b: #c3d4ed;
					--font-sans: "Space Grotesk", "M PLUS Rounded 1c", system-ui, sans-serif;
					--font-display: "Space Grotesk", "M PLUS Rounded 1c", system-ui, sans-serif;
					--font-mono: "Space Grotesk", "M PLUS Rounded 1c", system-ui, sans-serif;
					--globe-edge: 38vw;
					--globe-left: -12vw;
				}

			}
			
			@layer base {
				html, body { height: 100%; }

				body {
					background: var(--color-bg);
					color: var(--color-text);
					font-family: var(--font-sans);
					overflow-x: hidden;
				}

				::selection {
					background: var(--color-primary);
					color: var(--color-bg);
				}
			}

			@layer components {
				.brand {
					position: relative;
					z-index: 20;
					display: inline-flex;
					line-height: 0;
					border-radius: 8px;
					width: clamp(220px, 30vw, 380px);
					margin: 0 0 0.6rem;
					pointer-events: auto;
					transform-origin: top left;
					will-change: transform;
					animation: hero-rise 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
				}
				.brand:focus-visible {
					outline: 2px solid var(--color-primary);
					outline-offset: 4px;
				}
				.brand img {
					width: 100%;
					height: auto;
					display: block;
				}
				.brand-corner {
					position: fixed;
					z-index: 20;
					left: clamp(1.2rem, 4vw, 2.5rem);
					top: clamp(0.9rem, 2.5vw, 1.4rem);
					display: inline-flex;
					line-height: 0;
					border-radius: 8px;
					width: clamp(96px, 12vw, 132px);
					opacity: 0;
					visibility: hidden;
					transform: translateY(12px) scale(0.97);
					transform-origin: top left;
					pointer-events: none;
					transition:
						opacity 0.45s ease,
						transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
						visibility 0s linear 0.55s;
				}
				.brand-corner.show {
					opacity: 1;
					visibility: visible;
					transform: none;
					pointer-events: auto;
					transition:
						opacity 0.45s ease,
						transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
						visibility 0s;
				}
				.brand-corner:focus-visible {
					outline: 2px solid var(--color-primary);
					outline-offset: 4px;
				}
				.brand-corner img {
					width: 100%;
					height: auto;
					display: block;
				}
				@media (prefers-reduced-motion: reduce) {
					.brand, .brand-corner { animation: none; transition: none; }
				}

				html { scroll-behavior: auto; }

				.stage {
					position: relative;
					height: 100svh;
					min-height: 560px;
					overflow: hidden;
					background: var(--color-bg);
				}

				.stage canvas {
					position: fixed;
					inset: 0;
					width: 100vw;
					height: 100svh;
					display: block;
					z-index: 1;
				}
				

				.hero {
					position: absolute;
					z-index: 3;
					top: 50%;
					left: clamp(1.5rem, 6vw, 6rem);
					transform: translateY(-50%);
					max-width: min(42ch, 46vw);
					pointer-events: none;
					will-change: transform, opacity;
				}

				.hold {
					position: relative;
					z-index: 2;
					height: 220svh;
					background: transparent;
					pointer-events: none;
				}
				.hold-sticky {
					position: sticky;
					top: 0;
					height: 100svh;
					overflow: clip;
					pointer-events: none;
				}
				.hold-inner,
				.planner,
				.planner button,
				.planner select,
				.planner input {
					pointer-events: auto;
				}

				.next {
					position: relative;
					z-index: 2;
					min-height: 100svh;
					background: var(--color-bg);
				}

				.footer {
					position: relative;
					z-index: 2;
					background: var(--color-bg);
					border-top: 1px solid rgba(241, 234, 244, 0.08);
					padding: 1.1rem clamp(1.2rem, 4vw, 2.5rem) 1.4rem;
					display: flex;
					flex-wrap: wrap;
					align-items: baseline;
					gap: 0.4rem 1.2rem;
					font-family: var(--font-mono);
					font-size: 0.7rem;
					color: var(--color-muted);
				}
				.footer .f-brand {
					color: var(--color-text);
					letter-spacing: 0.08em;
				}
				.footer .f-sep {
					opacity: 0.35;
					user-select: none;
				}
				.footer a {
					color: var(--color-muted);
					text-decoration: none;
					border-bottom: 1px solid transparent;
					transition: color 0.15s, border-color 0.15s;
				}
				.footer a:hover {
					color: var(--color-primary);
					border-bottom-color: var(--color-primary);
				}
				.footer .f-right {
					margin-left: auto;
					opacity: 0.6;
				}

				.hero .kicker {
					font-family: var(--font-display);
					font-size: clamp(1.25rem, 2vw + 0.85rem, 1.9rem);
					letter-spacing: 0.1em;
					line-height: 1.5;
					color: var(--color-text);
					margin: 0 0 0.6rem;
					text-wrap: balance;
					text-shadow:
						0 1px 12px rgba(22, 14, 44, 0.95),
						0 0 2px rgba(22, 14, 44, 0.9);

					animation: hero-rise 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
				}

				.hero .kicker .k-mob { display: none; }

				.hero h1 {
					font-family: var(--font-display);
					font-size: clamp(3rem, 7vw, 7rem);
					line-height: 1;
					letter-spacing: 0.14em;
					font-weight: 700;
					-webkit-background-clip: text;
					background-clip: text;
					color: var(--color-primary);

					animation: rise 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
				}



				.hero p {
					margin-top: 0.7rem;
					font-family: var(--font-display);
					font-weight: 700;
					font-size: clamp(1rem, 1.3vw + 0.7rem, 1.35rem);
					letter-spacing: 0.08em;
					line-height: 1.8;
					color: var(--color-muted);
					text-shadow:
						0 1px 12px rgba(22, 14, 44, 0.95),
						0 0 2px rgba(22, 14, 44, 0.9);

					animation: hero-rise 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
				}

				.hero p b {
					color: var(--color-iroh);
					font-weight: 700;
				}

				.scroll-cue {
					margin-top: 2.4rem;
					display: flex;
					align-items: center;
					gap: 0.7rem;
					color: var(--color-muted);
					font-family: var(--font-mono);
					font-size: 0.72rem;
					letter-spacing: 0.34em;
					text-transform: uppercase;
					text-indent: 0.34em;
					animation: hero-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
				}

				.scroll-cue svg {
					width: 2rem;
					height: 2rem;
					animation: cue-nudge 2.2s ease-in-out 2s infinite;
				}

				@keyframes cue-nudge {
					0%, 100% { transform: translateY(0); opacity: 0.55; }
					50% { transform: translateY(7px); opacity: 1; }
				}

				@media (prefers-reduced-motion: reduce) {
					.scroll-cue,
					.scroll-cue svg {
						animation: none;
					}
				}

				@keyframes hero-rise {
					from { opacity: 0; transform: translateY(26px); }
					to { opacity: 1; transform: translateY(0); }
				}
				@keyframes rise {
					from { opacity: 0; transform: translateY(26px); }
					to { opacity: 1; transform: translateY(0); }
				}

				.hold-inner {
					height: 100%;
					--dock-gap: clamp(1.5rem, 4vw, 5rem);
					display: grid;
					grid-template-columns:
						calc(var(--globe-edge) - var(--globe-left) + var(--dock-gap))
						minmax(0, 1fr);
					align-items: center;
					pointer-events: none;
				}
				.hold-inner > * { pointer-events: auto; min-width: 0; }
				.hold-inner > .planner {
					grid-column: 2;
					justify-self: start;
					align-self: center;
					margin: 0;
					padding: 0;
					box-sizing: border-box;
				}

				.planner {
					--pl-ease: cubic-bezier(0.22, 1, 0.36, 1);
					position: relative;
					z-index: 10;
					display: flex;
					align-items: stretch;
					height: min(600px, 86svh);
					max-height: 86svh;
					width: max-content;
					max-width: min(94vw, calc(100vw - var(--globe-edge) - var(--dock-gap) - clamp(1rem, 3vw, 3rem)));
					background: linear-gradient(150deg, rgba(28, 17, 56, 0.94) 0%, rgba(19, 11, 40, 0.96) 100%);
					backdrop-filter: blur(14px);
					-webkit-backdrop-filter: blur(14px);
					border: 1px solid rgba(241, 234, 244, 0.12);
					border-radius: 20px;
					box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(241, 234, 244, 0.08);
					opacity: 0;
					visibility: hidden;
					transform: translateY(32px) scale(0.965);
					transform-origin: 80% 60%;
					pointer-events: none;
					transition: opacity 0.6s var(--pl-ease), transform 0.6s var(--pl-ease), visibility 0s linear 0.6s;
					overflow: visible;
				}
				.planner.visible {
					opacity: 1;
					visibility: visible;
					transform: translateY(0) scale(1);
					pointer-events: auto;
					transition: opacity 0.6s var(--pl-ease), transform 0.6s var(--pl-ease), visibility 0s;
				}
				.planner.visible .pl-col-build { animation: col-in 0.55s var(--pl-ease) 0.08s both; }
				.planner.visible .pl-col-active { animation: col-in 0.55s var(--pl-ease) 0.18s both; }
				@keyframes col-in {
					from { opacity: 0; transform: translateY(14px); }
					to { opacity: 1; transform: translateY(0); }
				}

				.pl-col-build {
					flex: 0 0 460px;
					width: 460px;
					max-width: 88vw;
					display: flex;
					flex-direction: column;
					padding: 1.4rem 1.4rem 1.2rem;
					min-height: 0;
					overflow: hidden;
				}
				.pl-divider {
					flex: 0 0 1px;
					align-self: stretch;
					background: linear-gradient(to bottom, transparent, rgba(241, 234, 244, 0.14), transparent);
					margin: 1.2rem 0;
				}
				.pl-col-active {
					flex: 0 0 300px;
					width: 300px;
					display: flex;
					flex-direction: column;
					padding: 1.4rem 1.4rem 1.2rem 1.2rem;
					min-height: 0;
					background: rgba(98, 87, 247, 0.05);
					overflow: hidden;
				}

				.planner h2 {
					font-family: var(--font-display);
					font-size: 1.25rem;
					letter-spacing: 0.02em;
					color: var(--color-text);
					margin: 0 0 0.3rem;
				}

				@media (max-width: 1199px) {
					.pl-divider,
					.pl-col-active {
						display: none;
					}
				}
				@media (min-width: 1200px) {
					.loc-list-narrow-head,
					.pl-col-build .loc-list {
						display: none;
					}
				}
				.pl-sub {
					font-family: var(--font-mono);
					font-size: 1.05rem;
					color: var(--color-muted);
					opacity: 0.95;
					margin: 0 0 1rem;
					line-height: 1.6;
				}

				.adder {
					display: grid;
					grid-template-columns: 96px 1fr 42px;
					gap: 0.5rem;
					margin-bottom: 0.35rem;
				}
				.adder select,
				.adder input {
					width: 100%;
					background: rgba(241, 234, 244, 0.055);
					border: 1px solid rgba(241, 234, 244, 0.14);
					border-radius: 10px;
					padding: 0.62rem 0.7rem;
					color: var(--color-text);
					font-family: var(--font-mono);
					font-size: 0.8rem;
					line-height: 1.35;
					outline: none;
					transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
				}
				.adder select {
					appearance: none;
					-webkit-appearance: none;
					background-image: linear-gradient(45deg, transparent 50%, var(--color-muted) 50%), linear-gradient(135deg, var(--color-muted) 50%, transparent 50%);
					background-position: calc(100% - 16px) 55%, calc(100% - 11px) 55%;
					background-size: 5px 5px;
					background-repeat: no-repeat;
					cursor: pointer;
					padding-right: 1.6rem;
					text-overflow: ellipsis;
				}
				.adder select:focus,
				.adder input:focus {
					border-color: var(--color-primary);
					background: rgba(212, 88, 157, 0.07);
					box-shadow: 0 0 0 3px rgba(212, 88, 157, 0.16);
				}
				.adder select option {
					background: #1a1035;
					color: var(--color-text);
				}
				.adder select.nudge {
					border-color: var(--color-primary);
					animation: select-nudge 0.6s ease;
				}
				@keyframes select-nudge {
					0%, 100% { box-shadow: 0 0 0 3px rgba(212, 88, 157, 0.16); }
					35% { box-shadow: 0 0 0 6px rgba(212, 88, 157, 0.32); }
				}
				.adder input::placeholder {
					color: var(--color-muted);
					opacity: 0.5;
				}
				.adder input:disabled {
					opacity: 0.45;
				}
				.btn-add {
					background: linear-gradient(135deg, var(--color-primary), #b23d82);
					border: 1px solid transparent;
					border-radius: 10px;
					color: #fff;
					font-family: var(--font-mono);
					font-size: 1.15rem;
					line-height: 1;
					cursor: pointer;
					transition: transform 0.15s, box-shadow 0.2s, opacity 0.2s;
					box-shadow: 0 4px 16px rgba(212, 88, 157, 0.35);
				}
				.btn-add:hover:not(:disabled) {
					transform: translateY(-1px);
					box-shadow: 0 8px 22px rgba(212, 88, 157, 0.45);
				}
				.btn-add:active:not(:disabled) {
					transform: translateY(0) scale(0.96);
				}
				.btn-add:disabled {
					opacity: 0.3;
					box-shadow: none;
					cursor: default;
				}
				.adder-hint {
					font-family: var(--font-mono);
					font-size: 0.92rem;
					color: var(--color-muted);
					opacity: 0.9;
					margin: 0 0 0.7rem;
					min-height: 1em;
				}

				.loc-field {
					position: relative;
					min-width: 0;
				}
				.loc-field input {
					width: 100%;
				}
				.suggest-list {
					position: absolute;
					top: calc(100% + 6px);
					left: 0;
					right: 0;
					display: flex;
					flex-direction: column;
					gap: 2px;
					max-height: calc(6 * 34px + 12px);
					overflow-y: auto;
					overflow-x: hidden;
					scrollbar-width: thin;
					scrollbar-color: rgba(212, 88, 157, 0.4) transparent;
					background: rgba(26, 16, 53, 0.98);
					border: 1px solid rgba(241, 234, 244, 0.14);
					border-radius: 12px;
					box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55);
					padding: 0.3rem;
					z-index: 60;
				}
				.suggest-list[hidden] { display: none; }
				.suggest-list button {
					display: flex;
					flex: 0 0 auto;
					align-items: baseline;
					gap: 0.55rem;
					width: 100%;
					min-width: 0;
					background: none;
					border: none;
					border-radius: 8px;
					padding: 0.5rem 0.6rem;
					color: var(--color-text);
					font-family: var(--font-mono);
					font-size: 0.82rem;
					text-align: left;
					cursor: pointer;
					transition: background 0.12s;
				}
				.suggest-list button:hover,
				.suggest-list button.hl {
					background: rgba(212, 88, 157, 0.16);
				}
				.suggest-list .s-addall {
					border: 1px dashed rgba(98, 87, 247, 0.55);
					background: rgba(98, 87, 247, 0.08);
					justify-content: space-between;
				}
				.suggest-list .s-addall:hover,
				.suggest-list .s-addall.hl {
					background: rgba(98, 87, 247, 0.22);
				}
				.suggest-list .s-addall-label {
					font-weight: 600;
				}
				.suggest-list .s-addall-count {
					color: var(--color-muted);
					opacity: 0.7;
					font-size: 0.68rem;
					flex-shrink: 0;
				}
				.suggest-list button .s-dot {
					width: 6px;
					height: 6px;
					border-radius: 50%;
					flex-shrink: 0;
					align-self: center;
				}
				.suggest-list button .s-city {
					flex: 1 1 auto;
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}

				.drafts {
					display: flex;
					flex-wrap: wrap;
					gap: 0.35rem;
					margin-bottom: 0.7rem;
				}
				.drafts:empty { display: none; }
				.draft {
					display: inline-flex;
					align-items: center;
					gap: 0.4rem;
					background: rgba(98, 87, 247, 0.14);
					border: 1px solid rgba(98, 87, 247, 0.45);
					border-radius: 999px;
					padding: 0.25rem 0.35rem 0.25rem 0.65rem;
					font-family: var(--font-mono);
					font-size: 0.68rem;
					color: var(--color-text);
					animation: chip-in 0.25s var(--pl-ease) both;
				}
				@keyframes chip-in {
					from { opacity: 0; transform: scale(0.85); }
					to { opacity: 1; transform: scale(1); }
				}
				.draft button {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					width: 16px;
					height: 16px;
					border-radius: 999px;
					border: none;
					background: rgba(241, 234, 244, 0.14);
					color: var(--color-text);
					font-size: 0.62rem;
					line-height: 1;
					padding: 0;
					cursor: pointer;
					transition: background 0.15s;
				}
				.draft button:hover { background: rgba(212, 88, 157, 0.6); }

				.active-head {
					font-family: var(--font-mono);
					font-size: 0.64rem;
					letter-spacing: 0.3em;
					text-transform: uppercase;
					color: var(--color-muted);
					opacity: 0.65;
					margin: 0 0 0.45rem;
				}
				.active-count {
					font-family: var(--font-mono);
					font-size: 0.68rem;
					color: var(--color-muted);
					opacity: 0.6;
					margin: 0 0 0.55rem;
				}
				.loc-list,
				.loc-list-side {
					overflow-y: auto;
					scrollbar-width: thin;
					scrollbar-color: rgba(212, 88, 157, 0.4) transparent;
				}
				.loc-list {
					flex: 0 1 auto;
					min-height: 0;
					max-height: calc(6 * 30px + 8px);
				}
				.loc-list-side {
					flex: 1 1 auto;
					min-height: 0;
				}
				.loc-item {
					display: flex;
					align-items: center;
					gap: 0;
					min-height: 22px;
					padding: 0.08rem 0;
					border-left: 1px solid transparent;
					border-right: 1px solid transparent;
					border-top: none;
					border-bottom: none;
					transition: background 0.15s, border-color 0.15s, opacity 0.25s;
					font-family: var(--font-mono);
					font-size: 0.74rem;
					color: var(--color-text);
					cursor: default;
